# ─────────────────────────────────────────────────────────────
# Supabase — required to run the app.
# ─────────────────────────────────────────────────────────────
# Local (via `supabase start`):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<printed by `supabase start`>
#
# Cloud project:
#   NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<from Supabase dashboard: Settings → API>
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# Supabase — server-side only (never expose to the client).
# ─────────────────────────────────────────────────────────────
# Used by admin scripts / seed / migrations. Not required at runtime.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Google OAuth — configured in the Supabase dashboard (Auth → Providers → Google),
# NOT read by the app directly. Keep them here as a reference for whoever provisions
# the Supabase project.
# ─────────────────────────────────────────────────────────────
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

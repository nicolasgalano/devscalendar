# ─────────────────────────────────────────────────────────────
# Supabase — required to run the app. Este archivo es para DESARROLLO.
#
# Los tests NO usan este archivo: van contra un proyecto aparte, con sus
# credenciales en `.env.test` (ver `.env.test.example`). Es una separación de
# seguridad, no de orden — la suite borra usuarios y filas.
# ─────────────────────────────────────────────────────────────
#   NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<dashboard de Supabase: Settings → API>
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# Supabase — server-side only (never expose to the client).
# ─────────────────────────────────────────────────────────────
# Used by admin scripts / seed / migrations. Not required at runtime.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Google OAuth — configured in the Supabase dashboard (Auth → Providers → Google),
# NOT read by the app directly. Keep them here as a reference for whoever provisions
# the Supabase project.
# ─────────────────────────────────────────────────────────────
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
